# Public Supabase project URL and anon/publishable key — safe to embed in the client bundle.
# The admin secret used to authorize privileged actions is entered at runtime through the
# dashboard's Settings modal (stored only in this browser's localStorage), never here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional Edge Function configuration (set via: supabase secrets set ALLOWED_ORIGIN=https://admin.yourdomain.com)
# ALLOWED_ORIGIN=https://your-admin-dashboard-domain.com
